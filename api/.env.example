# MySQL connection string (Railway ou local). Nunca commitar o .env real.
DATABASE_URL="mysql://user:password@host:3306/database"

# Porta HTTP da API (Railway injeta PORT automaticamente em produção)
PORT=3333

# Chave que o app mobile envia no header "x-api-key" em toda requisição
APP_API_KEY="troque-esta-chave-do-app"

# Chave separada para os endpoints admin (POST/PUT/DELETE /events), header "x-admin-key"
ADMIN_API_KEY="troque-esta-chave-admin"
