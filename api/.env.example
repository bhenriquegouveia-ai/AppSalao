# MySQL connection string (Railway ou local). Nunca commitar o .env real.
DATABASE_URL="mysql://user:password@host:3306/database"

# Porta HTTP da API (Railway injeta PORT automaticamente em produção)
PORT=3333

# Chave que o app mobile envia no header "x-api-key" em toda requisição
APP_API_KEY="troque-esta-chave-do-app"

# Chave separada para os endpoints admin (POST/PUT/DELETE /events), header "x-admin-key"
ADMIN_API_KEY="troque-esta-chave-admin"

# Segredo usado para assinar os tokens JWT de login (mín. 16 caracteres, gere um valor aleatório)
JWT_SECRET="troque-este-segredo-jwt-por-um-valor-aleatorio-longo"

# Chave da API do Resend (resend.com) para os lembretes por e-mail dos
# favoritos. Sem essa variável, o recurso simplesmente fica desligado.
RESEND_API_KEY=""

# Remetente dos e-mails de lembrete. Sem domínio verificado no Resend, use
# o remetente de testes "onboarding@resend.dev".
EMAIL_FROM="Salão Abrasel <onboarding@resend.dev>"

# Só para testes: manda o lembrete por e-mail imediatamente ao favoritar,
# ignorando os prazos reais (1 dia/1h/15min). NUNCA deixar "true" em produção.
DEBUG_EMAIL_ON_FAVORITE=false
