# URL base da API. Em dev, aponte para a API rodando localmente (use o IP da
# sua máquina na rede, não "localhost", se for testar em device físico).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3333

# Mesma chave configurada em APP_API_KEY na API (/api/.env)
EXPO_PUBLIC_API_KEY=troque-esta-chave-do-app
